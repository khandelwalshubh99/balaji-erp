# ---------------------------------------------------------------------------
# Balaji Enterprises ERP — environment
# Copy to .env and edit. .env is gitignored.
# ---------------------------------------------------------------------------

PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string

# --- Tally connection -------------------------------------------------------
# TALLY_MODE=simulated  -> boots an in-process fake TallyPrime that speaks the
#                          real XML/HTTP protocol. Nothing else changes.
# TALLY_MODE=live       -> talks to your actual TallyPrime installation.
#
# Switching to the real thing is ONLY these three lines. No code changes.
TALLY_MODE=simulated
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_COMPANY=Balaji Enterprises
TALLY_TIMEOUT_MS=20000

# --- Simulation knobs (ignored when TALLY_MODE=live) ------------------------
# Deterministic dataset seed. Same seed = same 800 SKUs / customers / bills.
MOCK_SEED=balaji-2026
# Fraction of requests the fake Tally fails, to exercise error handling (0..1).
MOCK_FAILURE_RATE=0
# Artificial round-trip latency, ms.
MOCK_LATENCY_MS=120

# --- Sync -------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=20
SYNC_ON_BOOT=true

# --- Purchase-order ingest (Gmail -> Apps Script -> here) -------------------
# Shared secret the Apps Script sends as: Authorization: Bearer <token>
# Leave EMPTY to switch the endpoint off entirely. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=

# --- The Google Sheet as the store ------------------------------------------
# Everything Tally does not hold — quotations, orders, dispatches, invoices,
# the audit trail — lives in a Google Sheet, and this machine keeps a copy.
#
# These two are normally set from the Connection screen and kept in the
# database, so the office can repoint at a new sheet without a deploy. They are
# here for the case the screen cannot cover: `npm run db:reset` has just deleted
# the settings along with everything else, and the environment is the only thing
# left that can say where to fetch it all back from.
#
# Both values come from scripts/erp-sheet-api.gs, deployed as a Web App:
#   SHEETS_WEBAPP_URL  the deployment's /exec URL. NOT /dev — that one only
#                      works in a browser you are already signed into.
#   SHEETS_TOKEN       printed by SHEETAPI_setup() in the script editor.
# SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfy.../exec
# SHEETS_TOKEN=

# Read the sheet before opening the port. Leave this on. With it off, the app
# serves screens that can mint a quotation number before it knows what number
# the sheet already reached — which is how one BE/SO number reaches two
# customers. Numbering refuses until a read succeeds, so turning this off makes
# the app read-only until you pull by hand.
SHEETS_PULL_ON_BOOT=true

# How often to read the sheet and send what is queued. 0 turns the timer off.
SHEETS_INTERVAL_MINUTES=10

# --- Business rules (Phase 1 reporting; Phase 4 will enforce these) ---------
LOW_STOCK_DEFAULT_REORDER_LEVEL=10
DEFAULT_CREDIT_PERIOD_DAYS=30

# --- Gmail mail log ---------------------------------------------------------
# Our own mail domains, comma separated. Anything sent FROM one of these is
# logged against its thread but never classified and never mints a number: our
# own quotation email contains every enquiry phrase there is, and reading it as
# a customer enquiry would invent a record out of our own reply.
# Unset, the ERP falls back to what the pushing script claims.
MAIL_OWN_DOMAINS=rbalajient.com

# Individual addresses of ours on a shared provider. The rediffmail account
# forwards into sales@, so rediffmail.com LOOKS like it belongs above — putting
# it there would mark every customer on rediffmail as us, and their orders would
# stop appearing with nothing in any log to say why. A shared provider is
# refused above; list the address here instead.
MAIL_OWN_ADDRESSES=rbalajient1@gmail.com,rbalajient@rediffmail.com

# Where the database lives. Unset means data/balaji.db. Set it to run a second
# instance, or to try something out without writing over the working database.
# DB_PATH=data/scratch.db
